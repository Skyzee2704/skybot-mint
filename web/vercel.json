{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd .. && npm ci",
  "buildCommand": "npm run build",
  "regions": ["sin1"],
  "functions": {
    "app/api/jobs/run/route.ts": { "maxDuration": 300, "regions": ["iad1"] },
    "app/api/cron/housekeeping/route.ts": { "maxDuration": 60 },
    "app/api/[...path]/route.ts": { "maxDuration": 60 },
    "app/api/test/server-sign-native-send/route.ts": { "maxDuration": 60, "regions": ["iad1"] },
    "app/api/test/server-sign-native-send/lookup/route.ts": { "maxDuration": 60, "regions": ["iad1"] },
    "app/api/test/server-sign-native-send/erc20/route.ts": { "maxDuration": 60, "regions": ["iad1"] }
  }
}
