{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd .. && npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "app/api/jobs/run/route.ts": { "maxDuration": 300 },
    "app/api/cron/housekeeping/route.ts": { "maxDuration": 60 },
    "app/api/[...path]/route.ts": { "maxDuration": 60 }
  }
}
