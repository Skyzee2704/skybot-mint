# Copy to .env (repo root or server/). Every value is optional. NEVER commit real values.

# Extra env files to load (comma-separated), e.g. a chmod-600 file with private RPC URLs
# ENV_FILES=/workspace/secrets/rpc.env

# --- Private RPC overrides (take priority over built-in public RPCs) ---
# RPC_<CHAIN>=https://...           single URL      (chains: ETHEREUM BASE POLYGON ARBITRUM BNB UNICHAIN INK ROBINHOOD ARC)
# RPC_URLS_<CHAIN>=https://a,https://b   several URLs
# DISABLE_PUBLIC_RPCS_<CHAIN>=true  use only your private RPCs for that chain
RPC_TIMEOUT_MS=8000

# --- API keys ---
OPENSEA_API_KEY=          # official OpenSea API v2: slug lookup, drop stages, allowlist check, mint-tx builder
ETHERSCAN_API_KEY=        # Etherscan v2 multichain verified ABIs (fallback: Blockscout -> Sourcify -> bytecode probe)

# --- Telegram (bot starts only when BOTH are set; answers only this user id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# --- Safety limits (native units; per-chain overrides exist in server/src/config/chains.ts) ---
MAX_PRICE_PER_NFT=0.05
MAX_DAILY_SPEND=0.25
MAX_GAS_PRICE_GWEI=200
GAS_MODE=normal           # eco | normal | aggressive

# --- Ops ---
VAULT_ADDRESS=            # default destination for "sweep NFTs to vault"
DATA_DIR=./data           # encrypted keystore + jobs (db.json, mode 0600)
API_HOST=127.0.0.1
API_PORT=4000
DASHBOARD_URL=http://localhost:3000
SESSION_TTL_MINUTES=240
KEYSTORE_SCRYPT_N=131072  # scrypt cost (2^17). Lower only for tests.

# --- Dashboard (web/) ---
# API_URL=http://127.0.0.1:4000   where Next.js proxies /api/*
