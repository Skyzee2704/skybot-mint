# ===== Shared / local pm2 =====
# Copy to .env (gitignored). For Vercel/Railway set vars in their dashboards — see DEPLOY.md

# Privy (app id is public; secret is server-only)
PRIVY_APP_ID=cmvhyys6g00ao0gl3sk2o75fy
PRIVY_APP_SECRET=
PRIVY_AUTH_PRIVATE_KEY=
PRIVY_AUTH_KEY_QUORUM_ID=

ADMIN_EMAILS=you@example.com

# Public web URL (Mini App + deep links). Local: http://localhost:3000. Prod: https://your-app.vercel.app
PUBLIC_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Public API URL (Railway/Render). When set, Telegram uses webhook instead of polling.
PUBLIC_API_URL=

# Database: leave empty for local SQLite under DATA_DIR. Prod: Neon postgres URL.
DATABASE_URL=
DATA_DIR=/workspace/nft-mint-bot-data

API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGINS=

ENV_FILES=/workspace/secrets/rpc.env
OPENSEA_API_KEY=
ETHERSCAN_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MyTradeSkyBOT
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USER_ID=
VAULT_ADDRESS=

MAX_PRICE_PER_NFT=0.05
MAX_DAILY_SPEND=0.25
MAX_GAS_PRICE_GWEI=200
GAS_MODE=normal
RATE_LIMIT_PER_MINUTE=60
