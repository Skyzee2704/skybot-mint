# SkyBOT Mint — environment variables
# Local: copy to .env (gitignored). Vercel: Project Settings → Environment Variables.
# Never commit real values. See DEPLOY.md for where each value comes from.

# ── Privy (dashboard.privy.io → App settings) ───────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=            # public App ID (inlined into the client bundle)
PRIVY_APP_SECRET=                    # server-only App secret
PRIVY_AUTH_PRIVATE_KEY=              # authorization key (wallet-auth:… / PEM) for server signing
PRIVY_AUTH_KEY_QUORUM_ID=            # key quorum ID that owns/signs for user wallets
PRIVY_MINT_POLICY_ID=                # optional: policy attached with the mint signer (limits targets/value/chains)
# Sign-in-only signer for Telegram /check (OpenSea upcoming-stage eligibility). Separate key + quorum + policy.
PRIVY_SIWE_AUTH_PRIVATE_KEY=         # private key of a dedicated authorization key (never logged)
PRIVY_SIWE_KEY_QUORUM_ID=            # 1-of-1 key quorum with that key's public key
PRIVY_SIWE_POLICY_ID=                # policy: ALLOW personal_sign only for OpenSea's login text

# ── App URLs ────────────────────────────────────────────────────────────────
PUBLIC_URL=http://localhost:3000     # prod: https://<project>.vercel.app (Mini App, deep links)
WEB_ORIGIN=                          # optional, defaults to PUBLIC_URL (CORS allowlist)
CORS_ORIGINS=                        # optional extra origins, comma-separated
# AGPL source link in the web footer. If you deploy a modified version, point this at your fork.
NEXT_PUBLIC_SOURCE_URL=https://github.com/Skyzee2704/skybot-mint

# ── Session (Telegram-first logins) ────────────────────────────────────────
SESSION_SECRET=                      # 32+ random bytes: openssl rand -hex 32

# ── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAILS=                        # comma-separated emails with admin role
ADMIN_TELEGRAM_IDS=                  # comma-separated Telegram user IDs with admin role
TELEGRAM_USER_ID=                    # primary admin Telegram ID (notifications)

# ── Telegram bot (@BotFather) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SkymintsBOT
TELEGRAM_WEBHOOK_SECRET=             # random string: openssl rand -hex 24 (webhook mode, Vercel)

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=                        # Neon Postgres (pooled URL). Empty locally → SQLite in DATA_DIR
DATA_DIR=./data                      # local only

# ── Upstash QStash (scheduling) ─────────────────────────────────────────────
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=                          # optional, regional endpoint override
JOB_LEAD_MS=20000                    # fire this many ms before stage start, then wait in-function
JOB_MAX_DURATION_SEC=300             # must match vercel.json maxDuration for /api/jobs/run

# ── Upstash Redis (optional, distributed rate limits) ──────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_MINUTE=60

# ── Data providers ──────────────────────────────────────────────────────────
OPENSEA_API_KEY=
ETHERSCAN_API_KEY=                   # Etherscan V2 (multichain) key

# ── RPC endpoints (private RPCs take priority; public RPCs are fallbacks) ──
# Per chain: RPC_<KEY>, RPC_URL_<KEY>, or RPC_URLS_<KEY> (comma-separated).
# Keys: ETHEREUM BASE POLYGON ARBITRUM BNB UNICHAIN INK ROBINHOOD ARC
RPC_ETHEREUM=
RPC_BASE=
RPC_POLYGON=
RPC_ARBITRUM=
RPC_BNB=
RPC_UNICHAIN=
RPC_INK=
RPC_ROBINHOOD=
RPC_ARC=
# DISABLE_PUBLIC_RPCS_<KEY>=true     # use only your private RPCs for that chain
RPC_TIMEOUT_MS=8000

# ── Safety defaults (per-user caps can be tightened in Settings) ───────────
MAX_PRICE_PER_NFT=0.05
MAX_DAILY_SPEND=0.25
MAX_GAS_PRICE_GWEI=200
GAS_MODE=normal
VAULT_ADDRESS=                       # optional default withdraw destination
ALCHEMY_AUTH_TOKEN=                  # optional: Alchemy Notify token (NFT holdings webhooks)
NEXT_PUBLIC_SITE_URL=                # optional: origin for link-preview URLs (default PUBLIC_URL)

# ── Local development only ──────────────────────────────────────────────────
# ENV_FILES=/path/to/extra.env       # extra env files to load (comma-separated)
# ALLOW_SERVER_KEY_IMPORT=false      # legacy raw-key import; keep disabled
